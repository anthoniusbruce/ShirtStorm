@page "/upcoming"
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@using ShirtStorm.Dtos
@using ShirtStormCommon.Models
@using ShirtStorm.Shared

@inject AuthenticationStateProvider authenticationStateProvider
@inject ShirtStormDbContext dbContext

<PageTitle>Shirt Storm Subscription</PageTitle>
<MudGrid>
    <MudItem xs="10"></MudItem>
    <MudItem xs="2" Style="display:flex;">
        <MudImage Fluid="true" Src="images/ShirtStormMasterLogoWithName.JPG" Alt="Shirt Storm!" Class="rounded-lg" />
    </MudItem>
</MudGrid>
@code
{
    private UpcomingDesignsDto upcomingDesignsDto = new UpcomingDesignsDto();
    private bool loading = false;

    protected override  async Task OnInitializedAsync()
    {
        if (!loading)
        {
            try
            {
                loading = true;
                var authState = await authenticationStateProvider.GetAuthenticationStateAsync();
                ClaimsPrincipal claimsPrincipalUser = authState.User;

                if (claimsPrincipalUser.Identity != null && claimsPrincipalUser.Identity.IsAuthenticated)
                {
                    var identityEmail = claimsPrincipalUser.FindFirstValue("emails")!;
                    var displayName = claimsPrincipalUser.Identity.Name!;
                    var firstName = claimsPrincipalUser.FindFirstValue(ClaimTypes.GivenName)!;
                    var surname = claimsPrincipalUser.FindFirstValue(ClaimTypes.Surname)!;

                    var customer = await (dbContext.Customers.Where(s => s.IdentityEmail == identityEmail).FirstOrDefaultAsync<Customer>());

                    if (customer == null)
                    {
                        // add record
                        customer = new Customer { Id = Guid.NewGuid(), IdentityEmail = identityEmail, DisplayName = displayName, Surname = surname, FirstName = firstName, IsAMember = false };
                        dbContext.Add(customer);
                        dbContext.SaveChanges();
                    }
                    else
                    {
                        // update record
                        customer.DisplayName = displayName;
                        customer.Surname = surname;
                        customer.FirstName = firstName;
                        dbContext.Update(customer);
                        dbContext.SaveChanges();

                        upcomingDesignsDto.IsAMember = customer.IsAMember;
                    }
                }
            }
            finally
            {
                loading = false;
            }
        }
    }
}