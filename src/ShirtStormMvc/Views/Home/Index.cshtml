@{
    ViewData["Title"] = "Home";
}

@await Component.InvokeAsync("Preamble", "Take a peek at some of our past designs below and get ready to weather the storm… one shirt at a time!")

<div id="front-page-list">
    Loading designs...
</div>

<script type="text/javascript">
    var callback = function() {
        // do loading
        $.ajax({
            url: '@Url.Action("LoadFrontPageList", "Home")',
            type: 'GET',
            success: function (data) {
                $('#front-page-list').html(data);
            },
            error: function() {
                $('#front-page-list').html("Sorry! Designs are not available at this time. :(");
            }
        });
    };

    if (document.readyState === "complete") {
        callback();
    } else {
        document.addEventListener("DOMContentLoaded", callback);
    }
</script>