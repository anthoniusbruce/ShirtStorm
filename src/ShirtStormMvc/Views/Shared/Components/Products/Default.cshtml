@model List<ProductViewModel>

<div>
	@for (int i = 0; i < Model.Count(); ++i)
	{
		<div class="upcoming-row">
			<div class="upcoming-col-20">
				<img src="@Model[i].Design.ImageSource" alt="@Model[i].Design.Title" />
			</div>
			<div class="upcoming-col-60" id="@Model[i].DesignId">
				<div>
					<p><i>@Model[i].Design.Title</i>, @Model[i].Design.Description</p>
					<div class="col-sm-12 address-table-div" id="order-grid-replacement">
						<table class="table address-table">
							<thead>
								<tr>
									<th>Whom For</th>
									<th>Shirt Size</th>
									<th>Send To</th>
									<th class="address-table-column-15"><a href="#" onclick="orderUpdateBlock(orderBlock:'@Model[i].DesignId');">Add Shirt</a></th>
								</tr>
							</thead>
							@foreach (var item in Model[i].OrderItems)
							{
								<tr>
									<td>@Html.DisplayFor(modelItem => item.WhoFor)</td>
									<td>@Html.DisplayFor(modelItem => item.Size)</td>
									<td>@Html.DisplayFor(modelItem => item.AddressAlias)</td>
									<td><a href="#" onclick="orderUpdateBlock(orderBlock:'@Model[i].DesignId',itemId:'@item.Id');">Edit</a> | <a asp-controller="UpcomingDesigns" asp-action="OrderItemDelete" asp-route-id="@item.Id" asp-route-returnTo="@Model[i].DesignId">Delete</a></td>
								</tr>
							}
						</table>
					</div>
				</div>
			</div>
			<div class="upcoming-col-20 order">
				<h1>Shirts:</h1>
				<div class="centered">
					@if (Model[i].OrderTotal == 1) 
					{
						<h2> @Model[i].OrderTotal shirt</h2>
					}
					else
					{
						<h2> @Model[i].OrderTotal shirts</h2>

					}
				</div>
			</div>
		</div>
	}
</div>

<script type="text/javascript">
	var orderUpdateBlock = function(orderBlock, itemId) {
		// do loading
		$.ajax({
			url: '@Url.Action("OrderUpdateBlock", "UpcomingDesigns")',
			type: 'GET',
			data: {
				id: itemId
			},
			success: function (data) {
				$('#'+orderBlock).html(data);
			},
			error: function() {
				$('#'+orderBlock).html("Sorry! Orders are not available at this time. :(");
			}
		});
	};
</script>
