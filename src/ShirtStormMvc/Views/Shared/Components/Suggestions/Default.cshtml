@model List<SuggestionViewModel>
<p>Feel free to submit as many suggestions as you want. Suggestions for the website and for future t-shirt designs (including pictures!) are welcome! Be sure to explain all relevant details. If we want to move ahead with your design, we will contact you first so we can work out the details.</p>
<div class="col-sm-12 address-table-div" id="address-control-replacement">
	<table class="table address-table">
		<tr>
			<th class="address-table-column-15">Date</th>
			<th class="address-table-column-70">Suggestion</th>
			<th class="address-table-column-15"><a href="#" onclick="suggestionUpdateBlock();">Add</a></th>
		</tr>
		@foreach (var item in Model)
		{
			<tr>
				<td>@Html.DisplayFor(modelItem => item.CreatedDate)</td>
				<td>@Html.DisplayFor(modelItem => item.Description)</td>
				<td><a href="#" onclick="suggestionUpdateBlock('@item.Id');">Edit</a> | <a asp-controller="UpcomingDesigns" asp-action="SuggestionDelete" asp-route-id="@item.Id">Delete</a></td>
			</tr>
		}
	</table>
</div>

<script type="text/javascript">
	var suggestionUpdateBlock = function(itemId) {
		// do loading
		$.ajax({
			url: '@Url.Action("SuggestionUpdateBlock", "UpcomingDesigns")',
			type: 'GET',
			data: {
				id: itemId
			},
			success: function (data) {
				$('#address-control-replacement').html(data);
			},
			error: function() {
				$('#address-control-replacement').html("Sorry! Suggestions are not available at this time. :(");
			}
		});
	};
</script>
