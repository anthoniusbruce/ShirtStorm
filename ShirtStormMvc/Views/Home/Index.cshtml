@using ShirtStormMvc.Views.Shared
@model List<ShirtStormMvc.Dtos.FrontPageDesignDto>

@{
    ViewData["Title"] = "Home";
}

<component type="typeof(Preamble)" render-mode="ServerPrerendered" />

<div class="designs-row">
    @for (int i = 0; i < Model.Count(); ++i)
    {
        <div class="designs-column">
            <img src="@Model[i].ImageSource" alt="@Model[i].Title" />
            <p>@Model[i].Description</p>
        </div>
    }
</div>
