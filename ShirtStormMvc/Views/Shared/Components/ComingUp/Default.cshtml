@model List<ComingUpViewModel>

<div>
	@for (int i = 0; i < Model.Count(); ++i)
	{
		<div class="upcoming-row">
			<div class="upcoming-col-20">
				<img src="@Model[i].Design.ImageSource" alt="@Model[i].Design.Title" />
			</div>
			<div class="upcoming-col-60">@Model[i].Design.Description</div>
			<div class="upcoming-col-20 order">
				<h1>Order:</h1>
				<div class="centered">
					@if (Model[i].OrderTotal == 1) 
					{
						<h2> @Model[i].OrderTotal shirt</h2>
					}
					else
					{
						<h2> @Model[i].OrderTotal shirts</h2>

					}
				</div>
			</div>
		</div>
	}
</div>