@using ShirtStormMvc.Models
@model UpcomingDesignsViewModel

@{
    ViewData["Title"] = "Upcoming";
    const string destinations = "Destinations";
    const string suggestions = "Suggestions";
    const string commissions = "Commissions";
    string? addressType = ViewData["addressType"] as string;
    string controllerMethod = "AddressViewCrud";
    string sorryMessage = "Addresses";
    if (addressType == suggestions)
    {
        controllerMethod = "SuggestionViewCrud";
        sorryMessage = suggestions;
    }
    else if (addressType == commissions)
    {
        controllerMethod = "CommissionViewCrud";
        sorryMessage = commissions;
    }
}

@if (Model.IsAMember)
{
    <div class="preamble-row">
        <div class="preamble-column">
            <div class="mini-navbar">
                @{
                    var order = new List<string> { destinations, suggestions, commissions };
                    if (addressType == suggestions)
                    {
                        order[0] = suggestions;
                        order[1] = destinations;
                    }
                    else if (addressType == commissions)
                    {
                        order[0] = commissions;
                        order[1] = destinations;
                        order[2] = suggestions;
                    }
                    <div class="mini-navbar-3col">
                        <h1>@order[0]!</h1>
                    </div>
                    var parm1 = new Dictionary<string, string> { { "addressType", order[1] } };
                    <div class="mini-navbar-3col">
                        <h2><a asp-controller="UpcomingDesigns" asp-action="Index" asp-all-route-data="@parm1">@order[1]</a></h2>
                    </div>
                    var parm2 = new Dictionary<string, string> { { "addressType", order[2] } };
                    <div class="mini-navbar-3col">
                        <h2><a asp-controller="UpcomingDesigns" asp-action="Index" asp-all-route-data="@parm2">@order[2]</a></h2>
                    </div>
                }
            </div>
            <div id="address-space">
                Loading Destinations! Suggestions! Commissions!...
            </div>
        </div>
        <div class="preamble-logo-column">
            <img src="/images/ShirtStormMasterLogoWithName.JPG" alt="Shirt Storm!" />
        </div>
    </div>
}
else
{
    @await Component.InvokeAsync("Preamble", "Take a peek at some of our upcoming designs below and get ready to weather the storm… one shirt at a time!")
}
<div id="upcoming-space">
    Loading Upcoming Designs...
</div>

<script type="text/javascript">
    var callback = function() {
        // do loading of address space
        $.ajax({
            url: '@Url.Action(@controllerMethod, "UpcomingDesigns")',
            type: 'GET',
            success: function (data) {
                $('#address-space').html(data);
            },
            error: function() {
                $('#address-space').html("Sorry! @sorryMessage are not available at this time. :(");
            }
        });
        // do loading of upcoming designs
        $.ajax({
            url: '@Url.Action("Upcoming", "UpcomingDesigns")',
            type: 'GET',
            success: function (data) {
                $('#upcoming-space').html(data);
            },
            error: function() {
                $('#upcoming-space').html("Sorry! Upcoming designs are not available at this time. :(");
            }
        });
    };

    if (document.readyState === "complete") {
        callback();
    } else {
        document.addEventListener("DOMContentLoaded", callback);
    }
</script>